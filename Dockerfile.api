FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models

WORKDIR /app

# FAISS and PyTorch require the OpenMP runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir --retries 10 --timeout 120 torch --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir --retries 10 --timeout 120 -r requirements.txt

COPY api ./api
COPY database ./database
COPY processor ./processor
COPY repositories ./repositories
COPY services ./services
COPY main.py ./main.py

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
