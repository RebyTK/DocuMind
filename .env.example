# PostgreSQL credentials used by Docker Compose.
# Replace the password with a strong local password before starting the stack.
POSTGRES_DB=documind
POSTGRES_USER=documind_app
POSTGRES_PASSWORD=replace-this-with-a-strong-password

# Optional overrides. The defaults below connect the API container to Ollama
# running on the Docker host and use the model already used by DocuMind.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
